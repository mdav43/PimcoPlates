{
  "name": "meridian-developer-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Central multi-project documentation portal (Docusaurus + OpenAPI) deployed to Cloudflare.",
  "scripts": {
    "docusaurus": "docusaurus",
    "gen-api": "npm run bundle-specs && node scripts/gen-api.mjs",
    "start": "npm run gen-api && docusaurus start",
    "build": "npm run gen-api && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "bundle-specs": "node scripts/bundle-specs.mjs",
    "clean-api": "node scripts/clean-api.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@docusaurus/theme-mermaid": "^3.10.0",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "docusaurus-plugin-openapi-docs": "^5.2.0",
    "docusaurus-theme-openapi-docs": "^5.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/tsconfig": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "@redocly/openapi-core": "^2.56.0",
    "typescript": "~5.8.0",
    "wrangler": "^4.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
